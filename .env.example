# Copy to .env.local for local development, and set the same names in Vercel (Project → Settings → Environment Variables).
# Leave all three empty to run Kaasu fully local (no accounts, no sync, prices from the local proxy).

# Supabase project (Project Settings → API). The anon / publishable key is meant to be public:
# row-level security in the database is what protects your data. NEVER put the service_role key here.
# (Vercel's Supabase integration injects NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY, which work too.)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Base URL of the deployed Cloudflare Worker (no trailing slash), e.g. https://kaasu-api.your-name.workers.dev
# Leave empty in development: Vite forwards /api to the local proxy.
VITE_API_BASE=

# Shown on the Privacy Policy and Terms pages (set these before inviting users).
VITE_COMPANY_NAME=
VITE_CONTACT_EMAIL=
