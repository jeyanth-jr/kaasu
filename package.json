{
  "name": "kaasu",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Local-first portfolio tracker for Indian retail investors",
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"vite --host\" \"tsx watch server/node.ts\"",
    "dev:web": "vite --host",
    "dev:proxy": "tsx watch server/node.ts",
    "proxy": "tsx server/node.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "start": "npm run build && concurrently -k -n web,api \"vite preview --host\" \"tsx server/node.ts\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker",
    "test": "vitest run",
    "test:watch": "vitest",
    "cf:dev": "wrangler dev",
    "cf:deploy": "wrangler deploy"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "canvas-confetti": "^1.9.4",
    "dexie": "^4.0.10",
    "dexie-react-hooks": "^1.1.7",
    "lucide-react": "^1.59.0",
    "motion": "^14.3.0",
    "papaparse": "^5.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "recharts": "^2.15.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@electric-sql/pglite": "^0.5.10",
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.10.2",
    "@types/papaparse": "^5.3.15",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.1.0",
    "fake-indexeddb": "^6.0.0",
    "jose": "^6.2.12",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "~7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1"
  },
  "engines": {
    "node": ">=22.12"
  },
  "license": "MIT"
}
