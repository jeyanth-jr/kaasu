{
  "name": "kaasu",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Local-first portfolio tracker for Indian retail investors",
  "scripts": {
    "dev": "concurrently -k -n web,proxy -c cyan,magenta \"vite --host\" \"tsx watch server/index.ts\"",
    "dev:web": "vite --host",
    "dev:proxy": "tsx watch server/index.ts",
    "proxy": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "start": "npm run build && concurrently -k -n web,proxy \"vite preview --host\" \"tsx server/index.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "dexie": "^4.0.10",
    "dexie-react-hooks": "^1.1.7",
    "papaparse": "^5.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "recharts": "^2.15.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@fontsource-variable/fraunces": "^5.1.0",
    "@fontsource/ibm-plex-sans": "^5.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/papaparse": "^5.3.15",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.1.0",
    "express": "^4.21.2",
    "fake-indexeddb": "^6.0.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "~5.7.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
